{
  "name": "libassimp-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "if [ ! -f ../dist/index.d.mts ]; then pnpm --dir .. exec tsdown; fi && node scripts/prepare-demo-artifacts.mjs && node scripts/measure-sizes.mjs && next build && node scripts/emit-mdx-aliases.mjs && VERIFY_STATIC_OUTPUT=true vitest run api-coverage.test.ts sizes.test.ts",
    "dev": "next dev",
    "predev": "node scripts/prepare-demo-artifacts.mjs && node scripts/measure-sizes.mjs",
    "format-matrix": "node scripts/format-matrix.mjs",
    "generate:source": "fumadocs-mdx",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.15.9",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-typescript": "5.4.0",
    "fumadocs-ui": "16.15.9",
    "libassimp": "workspace:*",
    "mermaid": "12.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
