{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "assimp/**",
    "build/**",
    "coverage/**",
    "dist/**",
    "docs-site/.next/**",
    "docs-site/.source/**",
    "docs-site/out/**",
    "src/wasm/**"
  ],
  "plugins": ["typescript", "unicorn"],
  "rules": {
    "max-params": ["error", { "max": 3 }]
  },
  "overrides": [
    {
      "files": ["tests/**/*.mjs", "bench/**/*.mjs"],
      "rules": { "typescript/no-floating-promises": "off" }
    }
  ]
}
