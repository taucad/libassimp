    "routes": {
      "3ds": {
        "extension": "3ds",
        "description": "Autodesk 3DS (legacy)",
        "nativeId": "3ds"
      },
      "3mf": {
        "extension": "3mf",
        "description": "3D Manufacturing Format",
        "nativeId": "3mf"
      },
      "assjson": {
        "extension": "json",
        "description": "Assimp JSON scene",
        "nativeId": "assjson"
      },
      "dae": {
        "extension": "dae",
        "description": "COLLADA Digital Asset Exchange",
        "nativeId": "collada"
      },
      "fbx": {
        "extension": "fbx",
        "description": "Autodesk FBX",
        "nativeId": "fbx",
        "options": [
          {
            "publicName": "binary",
            "nativeName": "@route/fbx-binary",
            "kind": "boolean",
            "default": true,
            "owners": ["FBX"],
            "description": "Write binary FBX when true and ASCII FBX when false.",
            "source": "assimp/code/Common/Exporter.cpp"
          }
        ],
        "routes": {
          "binary": {
            "true": "fbx",
            "false": "fbxa"
          }
        }
      },
      "glb": {
        "extension": "glb",
        "description": "glTF 2 binary container",
        "nativeId": "glb2"
      },
      "gltf": {
        "extension": "gltf",
        "description": "glTF 2 JSON with sidecars",
        "nativeId": "gltf2"
      },
      "obj": {
        "extension": "obj",
        "description": "Wavefront OBJ",
        "nativeId": "obj",
        "options": [
          {
            "publicName": "materials",
            "nativeName": "@route/obj-materials",
            "kind": "boolean",
            "default": true,
            "owners": ["Obj"],
            "description": "Write an MTL sidecar when the scene has materials.",
            "source": "assimp/code/Common/Exporter.cpp"
          }
        ],
        "routes": {
          "materials": {
            "true": "obj",
            "false": "objnomtl"
          }
        }
      },
      "ply": {
        "extension": "ply",
        "description": "Stanford Polygon Library",
        "nativeId": "ply",
        "options": [
          {
            "publicName": "binary",
            "nativeName": "@route/ply-binary",
            "kind": "boolean",
            "default": false,
            "owners": ["Ply"],
            "description": "Write binary PLY when true and ASCII PLY when false.",
            "source": "assimp/code/Common/Exporter.cpp"
          }
        ],
        "routes": {
          "binary": {
            "true": "plyb",
            "false": "ply"
          }
        }
      },
      "step": {
        "extension": "stp",
        "description": "ISO 10303 STEP",
        "nativeId": "stp"
      },
      "stl": {
        "extension": "stl",
        "description": "Stereolithography",
        "nativeId": "stl",
        "options": [
          {
            "publicName": "binary",
            "nativeName": "@route/stl-binary",
            "kind": "boolean",
            "default": false,
            "owners": ["STL"],
            "description": "Write binary STL when true and ASCII STL when false.",
            "source": "assimp/code/Common/Exporter.cpp"
          }
        ],
        "routes": {
          "binary": {
            "true": "stlb",
            "false": "stl"
          }
        }
      },
      "usda": {
        "extension": "usda",
        "description": "Universal Scene Description ASCII",
        "nativeId": "usda"
      },
      "usdz": {
        "extension": "usdz",
        "description": "Universal Scene Description ZIP container",
        "nativeId": "usdz"
      },
      "x": {
        "extension": "x",
        "description": "DirectX X file",
        "nativeId": "x"
      },
      "x3d": {
        "extension": "x3d",
        "description": "Extensible 3D",
        "nativeId": "x3d"
      }
